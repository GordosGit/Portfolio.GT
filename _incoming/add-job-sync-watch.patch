@@ -0,0 +1,156 @@
+"""Render the report as one self-contained HTML page (Off-World Cockpit style).
+
+Status colour mapping is functional, not decorative: GREEN = cyan, AMBER = amber,
+RED = neon pink. Every state also carries a text label so colour is never the
+only signal.
+"""
+from html import escape as e
+
+LIGHT = {
+    "GREEN": ("var(--cyan)", "ALL CLEAR", "Nothing to act on."),
+    "AMBER": ("var(--amber)", "WATCH", "Something needs a look before it becomes a problem."),
+    "RED": ("var(--neon-pink)", "ACTION NEEDED", "Jobs are failing or stuck right now."),
+}
+KIND_LABEL = {"NOT_LOADED": "Not loaded", "FIELD_MISMATCH": "Value mismatch", "STUCK_READY": "Stuck at ready"}
+
+CSS = """
+:root{--void:#08080a;--void-2:#0f0f13;--bone:#e8e4dc;--bone-dim:#8a8781;--amber:#ff8a1e;--amber-deep:#c25a00;
+--cyan:#7fd4d4;--cyan-deep:#2b6b6b;--neon-pink:#ff3c8a;--neon-gold:#ffcb45;--line:rgba(232,228,220,.12)}
+*{box-sizing:border-box;margin:0}
+body{background:var(--void);color:var(--bone);font:400 13px/1.55 'IBM Plex Mono',monospace;letter-spacing:.02em;
+background-image:radial-gradient(900px 500px at 85% -10%,rgba(255,138,30,.10),transparent 60%),radial-gradient(700px 500px at -10% 30%,rgba(127,212,212,.07),transparent 60%);
+background-attachment:fixed;min-height:100vh}
+main{max-width:1120px;margin:0 auto;padding:40px 24px 64px}
+h1,h2{font-family:'Space Grotesk',sans-serif;font-weight:300;letter-spacing:-.01em}
+h1{font-size:44px;line-height:1.1;margin:10px 0 6px}
+.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.28em;color:var(--amber);display:flex;align-items:center;gap:10px}
+.eyebrow:before{content:"";width:22px;height:1px;background:var(--amber)}
+.sub{color:var(--bone-dim);max-width:70ch}
+.asof{color:var(--cyan);margin-top:14px}
+.sec{margin-top:52px}
+.sec-head{display:flex;align-items:baseline;gap:14px;padding-bottom:12px;border-bottom:1px solid var(--line);position:relative;margin-bottom:20px}
+.sec-head:after{content:"";position:absolute;left:0;bottom:-1px;width:56px;height:1px;background:var(--amber);box-shadow:0 0 10px var(--amber)}
+.sec-head .n{color:var(--amber);font-size:12px}
+h2{font-size:26px}
+.status{display:grid;grid-template-columns:150px 1fr 320px;gap:28px;align-items:center}
+.housing{width:96px;margin:0 auto;padding:14px;border:1px solid var(--line);background:var(--void-2);display:grid;gap:12px;justify-items:center}
+.lamp{width:56px;height:56px;border-radius:50%;border:1px solid var(--line);background:#14141a}
+.lamp.on{background:var(--c);box-shadow:0 0 28px var(--c),0 0 70px color-mix(in srgb,var(--c) 45%,transparent);border-color:var(--c)}
+.verdict{font-family:'Space Grotesk',sans-serif;font-size:34px;font-weight:300;color:var(--c);line-height:1.1}
+.reasons{list-style:none;padding:0;margin-top:14px;color:var(--bone-dim)}
+.reasons li:before{content:"> ";color:var(--amber)}
+.panel{position:relative;border:1px solid var(--line);padding:18px 18px 10px;background:rgba(15,15,19,.7)}
+.panel:before,.panel:after{content:"";position:absolute;width:14px;height:14px;border:1px solid var(--amber)}
+.panel:before{left:-1px;top:-1px;border-right:0;border-bottom:0}
+.panel:after{right:-1px;bottom:-1px;border-left:0;border-top:0}
+.row{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px dashed var(--line)}
+.row:last-child{border-bottom:0}
+.row span:first-child{color:var(--bone-dim)}
+.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
+.card{background:var(--void);padding:18px}
+.type{display:flex;align-items:center;gap:8px;font-size:10px;text-transform:uppercase;letter-spacing:.2em;color:var(--bone-dim);margin-bottom:12px}
+.led{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}
+.led.amber{background:var(--amber);box-shadow:0 0 8px var(--amber)}
+.big{font-family:'Space Grotesk',sans-serif;font-size:40px;font-weight:300;line-height:1;margin-bottom:10px}
+table{width:100%;border-collapse:collapse}
+th{font-size:10px;text-transform:uppercase;letter-spacing:.2em;color:var(--bone-dim);font-weight:500;text-align:left;padding:8px 12px 8px 0;border-bottom:1px solid var(--line)}
+td:nth-child(-n+3){white-space:nowrap}
+td{padding:10px 12px 10px 0;border-bottom:1px dashed var(--line);vertical-align:top}
+.tag{display:inline-block;border:1px solid var(--cyan-deep);color:var(--cyan);padding:1px 8px;font-size:11px;white-space:nowrap}
+.tag.amber{border-color:var(--amber-deep);color:var(--amber)}
+.tag.pink{border-color:var(--neon-pink);color:var(--neon-pink)}
+.dim{color:var(--bone-dim)}
+.cols{display:grid;grid-template-columns:1.4fr 1fr;gap:28px}
+.bar{display:grid;grid-template-columns:130px 1fr 28px;gap:10px;align-items:center;margin:8px 0}
+.bar i{display:block;height:8px;background:var(--amber);box-shadow:0 0 8px rgba(255,138,30,.5)}
+.empty{color:var(--bone-dim);padding:14px 0}
+footer{margin-top:56px;padding-top:14px;border-top:1px solid var(--line);color:var(--bone-dim);font-size:11px}
+@media(max-width:860px){.status,.cols,.grid3{grid-template-columns:1fr}}
+@media(prefers-reduced-motion:no-preference){.lamp.on{animation:pulse 3s ease-in-out infinite}}
+@keyframes pulse{50%{filter:brightness(.82)}}
+"""
+
+
+def _hrs(h):
+    return f"{h * 60:.0f} min" if h < 1 else f"{h:.1f} h" if h < 48 else f"{h / 24:.1f} d"
+
+
+def _issue_rows(issues):
+    if not issues:
+        return '<p class="empty">No open issues.</p>'
+    rows = "".join(
+        f"<tr><td>{e(i['job_id'])}</td><td><span class='tag {'pink' if i['kind'] == 'NOT_LOADED' else 'amber'}'>"
+        f"{KIND_LABEL.get(i['kind'], i['kind'])}</span></td><td>{_hrs(i['age_hours'])}</td>"
+        f"<td>{e(i['cause'])}<div class='dim'>{e(i['detail'])}</div></td><td>{e(i['suggested_fix'])}</td></tr>"
+        for i in issues)
+    return ("<table><tr><th>Job</th><th>Problem</th><th>Open for</th><th>What happened</th>"
+            f"<th>Suggested fix</th></tr>{rows}</table>")
+
+
+def _risk_rows(risks):
+    if not risks:
+        return '<p class="empty">Nothing in Draft or Ready looks likely to fail.</p>'
+    rows = "".join(
+        f"<tr><td>{e(r['job_id'])}</td><td>{e(r['status'])}</td>"
+        f"<td><span class='tag {'pink' if r['level'] == 'HIGH' else 'amber'}'>{r['level']}</span></td>"
+        f"<td>{'<br>'.join(e(x) for x in r['reasons'])}</td></tr>"
+        for r in risks)
+    return f"<table><tr><th>Job</th><th>Status</th><th>Risk</th><th>Why</th></tr>{rows}</table>"
+
+
+def render_html(r, theme_css=""):
+    """theme_css: optional CSS appended after the built-in styles, so a theme can override them."""
+    color, label, blurb = LIGHT[r["light"]]
+    lamps = "".join(
+        f"<div class='lamp{' on' if r['light'] == name else ''}' style='--c:{LIGHT[name][0]}'></div>"
+        for name in ("RED", "AMBER", "GREEN"))
+    reasons = "".join(f"<li>{e(x)}</li>" for x in r["reasons"])
+    sc = r["status_counts"]
+    cards = "".join(
+        f"<div class='card'><div class='type'><span class='led{' amber' if t['reject_rate_pct'] >= 5 else ''}'></span>{e(t['label'])}</div>"
+        f"<div class='big'>{t['sent']}</div><div class='dim'>sent by planner</div>"
+        f"<div class='row'><span>Loaded by ERP</span><span>{t['loaded']}</span></div>"
+        f"<div class='row'><span>Rejected</span><span>{t['rejected']}</span></div>"
+        f"<div class='row'><span>Reject rate</span><span>{t['reject_rate_pct']}%</span></div></div>"
+        for t in r["totals"])
+    top = r["top_fields"]
+    mx = max((n for _, n in top), default=1)
+    bars = "".join(f"<div class='bar'><span>{e(f)}</span><i style='width:{100 * n / mx:.0f}%'></i><span>{n}</span></div>"
+                   for f, n in top) or "<p class='empty'>No rejects in 30 days.</p>"
+    tr = r["trend"]
+    return f"""<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1"><title>Job Sync Watch</title>
+<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet">
+<style>{CSS}</style>{f'<style>{theme_css}</style>' if theme_css else ''}</head><body><main>
+<div class="eyebrow">Integration monitor</div>
+<h1>Job Sync Watch</h1>
+<p class="sub">Planner to ERP job hand-off. Compares both sides, reads the loader log for the cause, and flags jobs likely to fail before they go out.</p>
+<p class="asof">AS OF {e(r['as_of'])} &middot; SYNTHETIC DATA</p>
+
+<section class="sec"><div class="sec-head"><span class="n">// 01</span><h2>Status</h2></div>
+<div class="status" style="--c:{color}">
+<div class="housing">{lamps}</div>
+<div><div class="verdict">{label}</div><div class="dim">{blurb}</div><ul class="reasons">{reasons}</ul></div>
+<div class="panel">
+<div class="row"><span>Open issues</span><span>{len(r['issues'])}</span></div>
+<div class="row"><span>Likely to fail next send</span><span>{len(r['risks'])}</span></div>
+<div class="row"><span>Sent, inside grace window</span><span>{r['pending']}</span></div>
+<div class="row"><span>Draft / Ready</span><span>{sc.get('Draft', 0)} / {sc.get('Ready to Send', 0)}</span></div>
+</div></div></section>
+
+<section class="sec"><div class="sec-head"><span class="n">// 02</span><h2>Period totals</h2></div>
+<div class="grid3">{cards}</div></section>
+
+<section class="sec"><div class="sec-head"><span class="n">// 03</span><h2>Open issues</h2></div>
+{_issue_rows(r['issues'])}</section>
+
+<section class="sec"><div class="sec-head"><span class="n">// 04</span><h2>Early warning</h2></div>
+<div class="cols"><div>{_risk_rows(r['risks'])}</div>
+<div class="panel"><div class="type"><span class="led amber"></span>Reject trend</div>
+<div class="row"><span>This 7 days</span><span>{tr['this_week_pct']}%</span></div>
+<div class="row"><span>Previous 7 days</span><span>{tr['prev_week_pct']}%</span></div>
+<div class="row"><span>Direction</span><span>{tr['direction']}</span></div>
+<div class="type" style="margin-top:18px">Rejects by field, 30 days</div>{bars}</div></div></section>
+
+<footer>Rules-based checks, not a model. Thresholds live in config.json. Snapshot generated at the time above.</footer>
+</main></body></html>"""
diff --git a/projects/job-sync-watch/jobwatch/risk.py b/projects/job-sync-watch/jobwatch/risk.py
new file mode 100644
index 0000000..f08c6a1
--- /dev/null
+++ b/projects/job-sync-watch/jobwatch/risk.py
@@ -0,0 +1,66 @@
+"""Pre-flight checks: which not-yet-sent jobs look likely to be rejected?
+
+These are rules, not machine learning. They encode what the loader is known to
+reject (blank required fields, lookup values that are not an exact match in the
+ERP master data) and what has been rejected recently. Each rule says why.
+"""
+from collections import Counter
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+from .reconcile import closest
+
+HIGH, MEDIUM = "HIGH", "MEDIUM"
+
+
+@dataclass
+class Risk:
+    job_id: str
+    status: str
+    level: str
+    reasons: list
+
+
+def recent_rejects(events, now, days=30):
+    """Counter of (field, value) -> times the loader rejected it in the window."""
+    cutoff = now - timedelta(days=days)
+    return Counter((e.field, e.value) for e in events
+                   if e.level == "ERROR" and e.kind == "lookup_not_found" and e.ts >= cutoff)
+
+
+def preflight(planner, events, lookups, now: datetime, cfg):
+    history = recent_rejects(events, now)
+    risks = []
+    for job in planner:
+        if job["status"] not in ("Draft", "Ready to Send"):
+            continue
+        reasons, level = [], None
+
+        for f in cfg["required_fields"]:
+            if str(job.get(f) if job.get(f) is not None else "").strip() == "":
+                reasons.append(f"{f} is blank")
+                level = HIGH
+
+        for f in cfg["lookup_fields"]:
+            v = job.get(f)
+            if v is None or str(v).strip() == "" or v in lookups.get(f, ()):
+                continue
+            tidy = str(v).strip().upper()
+            if tidy in lookups.get(f, ()):
+                reasons.append(f"{f} '{v}' only matches after trimming/upper-casing ({tidy}); the ERP lookup is exact")
+                level = level or MEDIUM
+            else:
+                hint = closest(v, lookups.get(f, ()))
+                msg = f"{f} '{v}' is not in the ERP master data"
+                msg += f" (closest: {hint})" if hint else ""
+                reasons.append(msg)
+                level = HIGH
+            n = history.get((f, str(v)), 0)
+            if n:
+                reasons.append(f"this exact value was rejected {n}x in the last 30 days")
+
+        if reasons:
+            risks.append(Risk(job["job_id"], job["status"], level, reasons))
+    # Ready jobs go out at the next scheduler run, so they come first
+    order = {("Ready to Send", HIGH): 0, ("Ready to Send", MEDIUM): 1, ("Draft", HIGH): 2, ("Draft", MEDIUM): 3}
+    return sorted(risks, key=lambda r: (order.get((r.status, r.level), 9), r.job_id))
diff --git a/projects/job-sync-watch/jobwatch/summary.py b/projects/job-sync-watch/jobwatch/summary.py
new file mode 100644
index 0000000..a2e437e
--- /dev/null
+++ b/projects/job-sync-watch/jobwatch/summary.py
@@ -0,0 +1,84 @@
+"""Turn issues, risks and log history into what the dashboard shows."""
+from collections import Counter
+from dataclasses import asdict
+from datetime import datetime, timedelta
+
+from .reconcile import find_issues
+from .risk import preflight
+
+GREEN, AMBER, RED = "GREEN", "AMBER", "RED"
+WINDOWS = [("Last 24 hours", 1), ("Last 7 days", 7), ("Last 30 days", 30)]
+
+
+def period_totals(planner, events, now):
+    rows = []
+    for label, days in WINDOWS:
+        start = now - timedelta(days=days)
+        sent = sum(1 for j in planner if j["status"] == "Sent to ERP"
+                   and datetime.fromisoformat(j["status_changed_at"]) >= start)
+        loaded = sum(1 for e in events if e.kind == "loaded" and e.ts >= start)
+        rejected = sum(1 for e in events if e.level == "ERROR" and e.ts >= start)
+        processed = loaded + rejected
+        rows.append({"label": label, "sent": sent, "loaded": loaded, "rejected": rejected,
+                     "reject_rate_pct": round(100 * rejected / processed, 1) if processed else 0.0})
+    return rows
+
+
+def reject_trend(events, now):
+    """Reject rate for the last 7 days vs the 7 days before that."""
+    def rate(a, b):
+        window = [e for e in events if now - timedelta(days=a) < e.ts <= now - timedelta(days=b)]
+        bad = sum(1 for e in window if e.level == "ERROR")
+        done = sum(1 for e in window if e.kind == "loaded") + bad
+        return round(100 * bad / done, 1) if done else 0.0, bad
+    (this, bad_now), (prev, _) = rate(7, 0), rate(14, 7)
+    # A single reject is noise, so "rising" needs at least two this week
+    direction = ("rising" if this - prev > 1 and bad_now >= 2
+                 else "falling" if prev - this > 1 else "flat")
+    return {"this_week_pct": this, "prev_week_pct": prev, "direction": direction}
+
+
+def top_rejected_fields(events, now, days=30):
+    cutoff = now - timedelta(days=days)
+    return Counter(e.field for e in events if e.level == "ERROR" and e.field and e.ts >= cutoff).most_common()
+
+
+def traffic_light(issues, risks, totals, cfg):
+    reds, ambers = [], []
+    n = len(issues)
+    oldest = max((i.age_hours for i in issues), default=0)
+    rate7 = totals[1]["reject_rate_pct"]
+    if n >= cfg["red_open_issues"]:
+        reds.append(f"{n} open issues (red at {cfg['red_open_issues']})")
+    if oldest >= cfg["red_oldest_issue_hours"]:
+        reds.append(f"oldest open issue is {oldest:.0f} h old (red at {cfg['red_oldest_issue_hours']} h)")
+    if rate7 >= cfg["red_reject_rate_pct"]:
+        reds.append(f"7-day reject rate {rate7}% (red at {cfg['red_reject_rate_pct']}%)")
+    if n:
+        ambers.append(f"{n} open issue{'s' if n != 1 else ''}")
+    if risks:
+        ambers.append(f"{len(risks)} job{'s' if len(risks) != 1 else ''} likely to fail on the next send")
+    if reds:
+        return RED, reds + ambers
+    if ambers:
+        return AMBER, ambers
+    return GREEN, ["No open issues, nothing at risk."]
+
+
+def build_summary(planner, erp, events, lookups, now: datetime, cfg):
+    issues = find_issues(planner, erp, events, lookups, now, cfg)
+    risks = preflight(planner, events, lookups, now, cfg)
+    totals = period_totals(planner, events, now)
+    light, reasons = traffic_light(issues, risks, totals, cfg)
+    pending = sum(1 for j in planner if j["status"] == "Sent to ERP"
+                  and now - datetime.fromisoformat(j["status_changed_at"]) < timedelta(minutes=cfg["grace_minutes"]))
+    counts = Counter(j["status"] for j in planner)
+    return {
+        "as_of": now.strftime("%Y-%m-%d %H:%M"),
+        "light": light, "reasons": reasons,
+        "issues": [asdict(i) for i in issues],
+        "risks": [asdict(r) for r in risks],
+        "totals": totals, "trend": reject_trend(events, now),
+        "top_fields": top_rejected_fields(events, now),
+        "pending": pending, "status_counts": dict(counts),
+    }
diff --git a/projects/job-sync-watch/scripts/generate_data.py b/projects/job-sync-watch/scripts/generate_data.py
new file mode 100644
index 0000000..2a2e4c7
--- /dev/null
+++ b/projects/job-sync-watch/scripts/generate_data.py
@@ -0,0 +1,200 @@
+#!/usr/bin/env python3
+"""Generate synthetic data for job-sync-watch.
+
+Produces four files in --out:
+  planner_jobs.json  what the planning system's API would return
+  erp.db             SQLite stand-in for the ERP jobs table
+  lookups.json       the ERP's valid lookup values (its master data)
+  integration.log    the ERP-side loader log
+
+Everything is invented. Two scenarios:
+  messy  a realistic bad day: open rejects, a silent mismatch, a stuck job,
+         and drafts that are about to fail
+  clean  history has a few old rejects, all fixed; nothing open
+"""
+import argparse
+import json
+import random
+import sqlite3
+from collections import defaultdict
+from datetime import datetime, timedelta
+from pathlib import Path
+
+LOOKUPS = {
+    "customer_code": [f"C-{i:04d}" for i in range(1, 61)],
+    "site_code": [f"S-{i:03d}" for i in range(1, 41)],
+    "equipment_class": ["CRN-100T", "CRN-250T", "CRN-500T", "RIG-SPMT", "RIG-GANTRY", "HAUL-MULTI"],
+    "cost_center": [f"CC-{1100 + 10 * i}" for i in range(10)],
+}
+# Typos people actually make. Customer has a small pool so some bad values recur.
+BAD_VALUES = {
+    "customer_code": ["C-0999", "C-0999", "C-0912"],
+    "site_code": ["S-999", "S-310"],
+    "equipment_class": ["CRN-250", "CRN-100", "CRANE-250T"],
+    "cost_center": ["CC-1105", "CC-1999"],
+}
+FIELDS = list(LOOKUPS)
+JOB_COLUMNS = ["job_id", *FIELDS, "start_date", "est_weight_t"]
+
+
+def iso(t):
+    return t.strftime("%Y-%m-%dT%H:%M:%S")
+
+
+def ceil15(t):
+    """The next 15-minute scheduler run at or after t (always moves forward)."""
+    t = t.replace(second=0, microsecond=0)
+    return t + timedelta(minutes=15 - t.minute % 15)
+
+
+def floor15(t):
+    t = t.replace(second=0, microsecond=0)
+    return t - timedelta(minutes=t.minute % 15)
+
+
+class World:
+    def __init__(self, rng, now):
+        self.rng, self.now = rng, now
+        self.jobs, self.erp, self.log = [], {}, []
+        self.batches = defaultdict(int)
+        self.next_id = 10000
+
+    def new_job(self, changed, status="Draft", **override):
+        self.next_id += 1
+        r = self.rng
+        job = {
+            "job_id": f"J-{self.next_id}",
+            **{f: r.choice(LOOKUPS[f]) for f in FIELDS},
+            "start_date": (changed + timedelta(days=r.randint(3, 40))).strftime("%Y-%m-%d"),
+            "est_weight_t": round(r.uniform(5, 420), 1),
+            "status": status,
+            "status_changed_at": iso(changed),
+        }
+        job.update(override)
+        self.jobs.append(job)
+        return job
+
+    def write_log(self, ts, level, job_id, kind, **kv):
+        extra = "".join(f" {k}={v}" for k, v in kv.items())
+        self.log.append((ts, f"{iso(ts)} {level} job={job_id} {kind}{extra}"))
+
+    def send(self, job, sent, outcome, fix_prob=0.0):
+        """Mark a job sent at `sent`, then play out what the ERP loader did."""
+        job["status"] = "Sent to ERP"
+        job["status_changed_at"] = iso(sent)
+        self.batches[sent] += 1
+        land = sent + timedelta(minutes=self.rng.randint(3, 10))
+        if land > self.now:
+            return  # consumer has not picked it up yet
+        if outcome == "reject":
+            bad = job["_bad"]
+            self.write_log(land, "ERROR", job["job_id"], "lookup_not_found", field=bad, value=job[bad])
+            if fix_prob and self.rng.random() < fix_prob:
+                # Someone found it in the logs, fixed the value, reset the status
+                fixed_at = sent + timedelta(hours=self.rng.randint(3, 20), minutes=self.rng.randint(0, 59))
+                job[bad] = self.rng.choice(LOOKUPS[bad])
+                job.pop("_bad")
+                self.send(job, ceil15(fixed_at), "ok")
+            return
+        row = {c: job[c] for c in JOB_COLUMNS}
+        if outcome == "mismatch":  # silent: loader shifts the date, logs success
+            d = datetime.strptime(row["start_date"], "%Y-%m-%d") + timedelta(days=1)
+            row["start_date"] = d.strftime("%Y-%m-%d")
+        self.erp[job["job_id"]] = row
+        self.write_log(land, "INFO", job["job_id"], "loaded")
+
+    def corrupt(self, job, field):
+        job[field] = self.rng.choice(BAD_VALUES[field])
+        job["_bad"] = field
+
+
+def build(scenario, now, seed, days):
+    rng = random.Random(seed)
+    w = World(rng, now)
+    clean = scenario == "clean"
+
+    # Background history: weekday jobs, mostly fine
+    for offset in range(days, 0, -1):
+        day = (now - timedelta(days=offset)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if day.weekday() >= 5:
+            continue
+        for _ in range(rng.randint(8, 15)):
+            ready = day + timedelta(hours=rng.randint(7, 16), minutes=rng.randint(0, 59))
+            sent = ceil15(ready)
+            if sent > now - timedelta(hours=1):
+                continue
+            job = w.new_job(ready)
+            age_days = (now - sent).total_seconds() / 86400
+            roll = rng.random()
+            if roll < 0.035 and (not clean or age_days > 4):
+                w.corrupt(job, rng.choice(FIELDS))
+                # old rejects usually get fixed by hand; clean scenario fixes all
+                w.send(job, sent, "reject", fix_prob=1.0 if age_days > 1.5 else 0.0)
+            elif roll > 0.97 and not clean and age_days < 3:
+                w.send(job, sent, "mismatch")
+            else:
+                w.send(job, sent, "ok")
+
+    if not clean:
+        m = lambda n: now - timedelta(minutes=n)
+        # Open rejects of different ages
+        for mins, field in [(130, "customer_code"), (360, "cost_center"), (30 * 60, "site_code")]:
+            job = w.new_job(m(mins + 60))
+            w.corrupt(job, field)
+            w.send(job, floor15(m(mins)), "reject")
+        # Silent mismatch from yesterday
+        w.send(w.new_job(m(20 * 60 + 60)), floor15(m(20 * 60)), "mismatch")
+        # Marked ready 50 minutes ago, scheduler never picked it up
+        w.new_job(m(50), status="Ready to Send")
+        # Sent 4 minutes ago, consumer has not picked it up yet (normal)
+        w.send(w.new_job(m(10)), floor15(m(4)), "ok")
+        # Drafts and ready jobs that will fail if nobody looks
+        job = w.new_job(m(10), status="Ready to Send"); job["equipment_class"] = "CRN-250"
+        job = w.new_job(m(5), status="Ready to Send"); job["cost_center"] = ""
+        job = w.new_job(m(90), status="Draft"); job["customer_code"] = " c-0042"
+        job = w.new_job(m(40), status="Draft"); job["customer_code"] = "C-0999"
+        w.new_job(m(25), status="Draft")  # a healthy draft
+    else:
+        w.new_job(now - timedelta(minutes=25), status="Draft")
+        w.new_job(now - timedelta(minutes=8), status="Ready to Send")
+
+    for sent, n in w.batches.items():
+        if sent + timedelta(seconds=1) <= now:
+            w.log.append((sent, f"{iso(sent + timedelta(seconds=1))} INFO batch file=jobs_{sent:%Y%m%d_%H%M}.csv rows={n}"))
+    return w
+
+
+def write(w, out):
+    out = Path(out)
+    out.mkdir(parents=True, exist_ok=True)
+    jobs = sorted(w.jobs, key=lambda j: j["job_id"])
+    clean_jobs = [{k: v for k, v in j.items() if not k.startswith("_")} for j in jobs]
+    (out / "planner_jobs.json").write_text(json.dumps(clean_jobs, indent=1) + "\n")
+    (out / "lookups.json").write_text(json.dumps(LOOKUPS, indent=1) + "\n")
+    (out / "integration.log").write_text("\n".join(line for _, line in sorted(w.log, key=lambda x: x[1])) + "\n")
+    db = out / "erp.db"
+    db.unlink(missing_ok=True)
+    con = sqlite3.connect(db)
+    con.execute("CREATE TABLE jobs (job_id TEXT PRIMARY KEY, customer_code TEXT, site_code TEXT, "
+                "equipment_class TEXT, cost_center TEXT, start_date TEXT, est_weight_t REAL)")
+    con.executemany("INSERT INTO jobs VALUES (?,?,?,?,?,?,?)",
+                    [tuple(r[c] for c in JOB_COLUMNS) for r in w.erp.values()])
+    con.commit()
+    con.close()
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--out", required=True)
+    p.add_argument("--scenario", choices=["messy", "clean"], default="messy")
+    p.add_argument("--now", default=iso(datetime.now().replace(microsecond=0)))
+    p.add_argument("--seed", type=int, default=7)
+    p.add_argument("--days", type=int, default=30)
+    a = p.parse_args()
+    w = build(a.scenario, datetime.fromisoformat(a.now), a.seed, a.days)
+    write(w, a.out)
+    print(f"{a.scenario}: {len(w.jobs)} planner jobs, {len(w.erp)} ERP rows -> {a.out}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/projects/job-sync-watch/tests/test_jobwatch.py b/projects/job-sync-watch/tests/test_jobwatch.py
new file mode 100644
index 0000000..80ffedd
--- /dev/null
+++ b/projects/job-sync-watch/tests/test_jobwatch.py
@@ -0,0 +1,119 @@
+"""Small hand-built fixtures: each test sets up two or three jobs and checks one rule."""
+import json
+from datetime import datetime
+from pathlib import Path
+
+from jobwatch.loaders import LogEvent
+from jobwatch.reconcile import FIELD_MISMATCH, NOT_LOADED, STUCK_READY, find_issues
+from jobwatch.risk import HIGH, MEDIUM, preflight
+from jobwatch.summary import AMBER, GREEN, RED, build_summary, reject_trend
+
+CFG = json.loads((Path(__file__).parent.parent / "config.json").read_text())
+NOW = datetime(2026, 10, 30, 9, 30)
+LOOKUPS = {"customer_code": {"C-0001", "C-0042"}, "site_code": {"S-001"},
+           "equipment_class": {"CRN-250T"}, "cost_center": {"CC-1100"}}
+
+
+def job(job_id, status="Sent to ERP", changed="2026-10-30T07:00:00", **kw):
+    base = {"job_id": job_id, "customer_code": "C-0001", "site_code": "S-001",
+            "equipment_class": "CRN-250T", "cost_center": "CC-1100",
+            "start_date": "2026-11-10", "est_weight_t": 100.0,
+            "status": status, "status_changed_at": changed}
+    return {**base, **kw}
+
+
+def erp_row(j, **kw):
+    return {**{k: j[k] for k in ("job_id", "customer_code", "site_code", "equipment_class",
+                                  "cost_center", "start_date", "est_weight_t")}, **kw}
+
+
+def test_matching_job_is_not_an_issue():
+    j = job("J-1")
+    assert find_issues([j], {"J-1": erp_row(j)}, [], LOOKUPS, NOW, CFG) == []
+
+
+def test_recently_sent_job_gets_grace_period():
+    j = job("J-1", changed="2026-10-30T09:10:00")  # 20 min ago, grace is 30
+    assert find_issues([j], {}, [], LOOKUPS, NOW, CFG) == []
+
+
+def test_missing_job_is_flagged_with_cause_and_closest_value():
+    j = job("J-1", customer_code="C-0043")
+    ev = [LogEvent(datetime(2026, 10, 30, 7, 5), "ERROR", "J-1", "lookup_not_found", "customer_code", "C-0043")]
+    [i] = find_issues([j], {}, ev, LOOKUPS, NOW, CFG)
+    assert i.kind == NOT_LOADED
+    assert "C-0043" in i.cause
+    assert "C-0042" in i.suggested_fix
+
+
+def test_old_error_before_resend_is_ignored():
+    j = job("J-1", changed="2026-10-30T08:00:00")
+    ev = [LogEvent(datetime(2026, 10, 29, 12, 0), "ERROR", "J-1", "lookup_not_found", "site_code", "S-999")]
+    [i] = find_issues([j], {}, ev, LOOKUPS, NOW, CFG)
+    assert "No loader error logged" in i.cause
+
+
+def test_silent_mismatch_is_flagged():
+    j = job("J-1")
+    [i] = find_issues([j], {"J-1": erp_row(j, start_date="2026-11-11")}, [], LOOKUPS, NOW, CFG)
+    assert i.kind == FIELD_MISMATCH and "start_date" in i.detail
+
+
+def test_whitespace_and_float_noise_are_not_mismatches():
+    j = job("J-1")
+    row = erp_row(j, customer_code="C-0001 ", est_weight_t=100.004)
+    assert find_issues([j], {"J-1": row}, [], LOOKUPS, NOW, CFG) == []
+
+
+def test_stuck_ready_job():
+    [i] = find_issues([job("J-1", "Ready to Send", "2026-10-30T08:40:00")], {}, [], LOOKUPS, NOW, CFG)
+    assert i.kind == STUCK_READY
+    assert find_issues([job("J-2", "Ready to Send", "2026-10-30T09:20:00")], {}, [], LOOKUPS, NOW, CFG) == []
+
+
+def test_preflight_levels():
+    jobs = [job("J-1", "Draft"),
+            job("J-2", "Ready to Send", site_code="S-999"),
+            job("J-3", "Draft", customer_code=" c-0042"),
+            job("J-4", "Ready to Send", cost_center=""),
+            job("J-5", "Sent to ERP", site_code="S-999")]  # already sent: not a pre-flight concern
+    risks = {r.job_id: r for r in preflight(jobs, [], LOOKUPS, NOW, CFG)}
+    assert set(risks) == {"J-2", "J-3", "J-4"}
+    assert risks["J-2"].level == HIGH and risks["J-4"].level == HIGH
+    assert risks["J-3"].level == MEDIUM
+
+
+def test_preflight_mentions_recurring_bad_value():
+    ev = [LogEvent(datetime(2026, 10, 20, 9, 0), "ERROR", f"J-{n}", "lookup_not_found", "site_code", "S-999")
+          for n in range(3)]
+    [r] = preflight([job("J-9", "Draft", site_code="S-999")], ev, LOOKUPS, NOW, CFG)
+    assert any("3x" in x for x in r.reasons)
+
+
+def test_traffic_light_green_amber_red():
+    ok = job("J-1")
+    erp = {"J-1": erp_row(ok)}
+    assert build_summary([ok], erp, [], LOOKUPS, NOW, CFG)["light"] == GREEN
+    risky = job("J-2", "Draft", site_code="S-999")
+    assert build_summary([ok, risky], erp, [], LOOKUPS, NOW, CFG)["light"] == AMBER
+    missing = [job(f"M-{n}") for n in range(4)]
+    assert build_summary([ok, *missing], erp, [], LOOKUPS, NOW, CFG)["light"] == RED
+
+
+def test_old_open_issue_turns_light_red():
+    old = job("J-1", changed="2026-10-29T06:00:00")  # 27 h, not loaded
+    assert build_summary([old], {}, [], LOOKUPS, NOW, CFG)["light"] == RED
+
+
+def test_one_reject_is_not_a_rising_trend():
+    ev = [LogEvent(datetime(2026, 10, 28, 9, 0), "ERROR", "J-1", "lookup_not_found", "site_code", "S-999"),
+          LogEvent(datetime(2026, 10, 28, 9, 5), "INFO", "J-2", "loaded")]
+    assert reject_trend(ev, NOW)["direction"] == "flat"
+
+
+def test_theme_css_is_appended_after_builtin_styles():
+    from jobwatch.render import render_html
+    report = build_summary([job("J-1")], {"J-1": erp_row(job("J-1"))}, [], LOOKUPS, NOW, CFG)
+    plain, themed = render_html(report), render_html(report, "body{background:#fff}/*THEME*/")
+    assert "THEME" not in plain
+    assert themed.index("THEME") > themed.index("<style>") and themed.count("<style>") == 2
