@@ -0,0 +1,78 @@
+"""Usage:
+  python -m jobwatch build --data DIR [--now ISO] [--out dashboard.html] [--json report.json] [--theme theme.css]
+  python -m jobwatch serve --data DIR [--port 8080] [--now ISO] [--theme theme.css]
+"""
+import argparse
+import json
+from datetime import datetime
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from pathlib import Path
+
+from .loaders import load_all, load_config
+from .render import render_html
+from .summary import build_summary
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def make_report(data_dir, config, now):
+    planner, erp, lookups, events = load_all(data_dir)
+    return build_summary(planner, erp, events, lookups, now, load_config(config))
+
+
+def read_theme(path):
+    return Path(path).read_text() if path else ""
+
+
+def parse_now(s):
+    return datetime.fromisoformat(s) if s else datetime.now().replace(microsecond=0)
+
+
+def cmd_build(a):
+    report = make_report(a.data, a.config, parse_now(a.now))
+    Path(a.out).write_text(render_html(report, read_theme(a.theme)))
+    if a.json:
+        Path(a.json).write_text(json.dumps(report, indent=1) + "\n")
+    print(f"{report['light']}: {len(report['issues'])} open issues, "
+          f"{len(report['risks'])} at risk -> {a.out}")
+
+
+def cmd_serve(a):
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            # Rebuilt on every request, so a refresh is always current
+            body = render_html(make_report(a.data, a.config, parse_now(a.now)), read_theme(a.theme)).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "text/html; charset=utf-8")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *args):
+            pass
+
+    print(f"Serving on http://127.0.0.1:{a.port}  (Ctrl+C to stop)")
+    HTTPServer(("127.0.0.1", a.port), Handler).serve_forever()
+
+
+def main():
+    p = argparse.ArgumentParser(prog="jobwatch")
+    sub = p.add_subparsers(dest="cmd", required=True)
+    for name, fn in (("build", cmd_build), ("serve", cmd_serve)):
+        s = sub.add_parser(name)
+        s.add_argument("--data", required=True, help="folder with the four input files")
+        s.add_argument("--config", default=str(ROOT / "config.json"))
+        s.add_argument("--now", help="ISO time to treat as 'now' (default: the real current time)")
+        s.add_argument("--theme", help="CSS file appended after the built-in styles")
+        if name == "build":
+            s.add_argument("--out", default="dashboard.html")
+            s.add_argument("--json", help="also write the report as JSON")
+        else:
+            s.add_argument("--port", type=int, default=8080)
+        s.set_defaults(fn=fn)
+    a = p.parse_args()
+    a.fn(a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/projects/job-sync-watch/jobwatch/loaders.py b/projects/job-sync-watch/jobwatch/loaders.py
new file mode 100644
index 0000000..5e83a05
--- /dev/null
+++ b/projects/job-sync-watch/jobwatch/loaders.py
@@ -0,0 +1,63 @@
+"""Read the four inputs. Swap these for real API / SQL / log readers; nothing else changes."""
+import json
+import re
+import sqlite3
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+
+LOG_LINE = re.compile(r"^(\S+) (INFO|WARN|ERROR) job=(\S+) (\w+)(.*)$")
+KV = re.compile(r"(\w+)=(\S+)")
+
+
+@dataclass
+class LogEvent:
+    ts: datetime
+    level: str
+    job_id: str
+    kind: str  # "loaded", "lookup_not_found", ...
+    field: str = ""
+    value: str = ""
+
+
+def load_config(path):
+    return json.loads(Path(path).read_text())
+
+
+def load_planner(path):
+    """Stand-in for the planning system's job extract API."""
+    return json.loads(Path(path).read_text())
+
+
+def load_erp(path):
+    """Stand-in for `SELECT * FROM jobs` against the ERP job tables."""
+    con = sqlite3.connect(path)
+    con.row_factory = sqlite3.Row
+    try:
+        return {r["job_id"]: dict(r) for r in con.execute("SELECT * FROM jobs")}
+    finally:
+        con.close()
+
+
+def load_lookups(path):
+    return {k: set(v) for k, v in json.loads(Path(path).read_text()).items()}
+
+
+def parse_log(path):
+    """Keep per-job lines. Batch summary lines and anything unrecognised are skipped."""
+    events = []
+    for line in Path(path).read_text().splitlines():
+        m = LOG_LINE.match(line)
+        if not m:
+            continue
+        ts, level, job_id, kind, rest = m.groups()
+        kv = dict(KV.findall(rest))
+        events.append(LogEvent(datetime.fromisoformat(ts), level, job_id, kind,
+                               kv.get("field", ""), kv.get("value", "")))
+    return events
+
+
+def load_all(data_dir):
+    d = Path(data_dir)
+    return (load_planner(d / "planner_jobs.json"), load_erp(d / "erp.db"),
+            load_lookups(d / "lookups.json"), parse_log(d / "integration.log"))
diff --git a/projects/job-sync-watch/jobwatch/reconcile.py b/projects/job-sync-watch/jobwatch/reconcile.py
new file mode 100644
index 0000000..f629413
--- /dev/null
+++ b/projects/job-sync-watch/jobwatch/reconcile.py
@@ -0,0 +1,84 @@
+"""Find jobs where the planning system and the ERP disagree, and say why."""
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from difflib import get_close_matches
+
+NOT_LOADED = "NOT_LOADED"          # sent, past the grace window, not in the ERP
+FIELD_MISMATCH = "FIELD_MISMATCH"  # in the ERP but a value differs
+STUCK_READY = "STUCK_READY"        # "Ready to Send" for longer than the scheduler should allow
+
+
+@dataclass
+class Issue:
+    job_id: str
+    kind: str
+    since: str          # ISO time the clock started (sent, or marked ready)
+    age_hours: float
+    detail: str
+    cause: str
+    suggested_fix: str
+
+
+def same(a, b):
+    """Compare values the way a person would: trim text, tolerate float noise."""
+    try:
+        return abs(float(a) - float(b)) < 0.01
+    except (TypeError, ValueError):
+        return str(a if a is not None else "").strip() == str(b if b is not None else "").strip()
+
+
+def closest(value, valid):
+    m = get_close_matches(str(value).strip().upper(), sorted(valid), n=1, cutoff=0.75)
+    return m[0] if m else None
+
+
+def _explain_reject(job, events, sent_at, lookups):
+    """Latest ERROR for this job since it was last sent."""
+    errs = [e for e in events if e.job_id == job["job_id"] and e.level == "ERROR" and e.ts >= sent_at]
+    if not errs:
+        return ("No loader error logged. The file may not have been picked up, or the "
+                "loader failed before reading this row.",
+                "Check the consumer job and the drop folder, then reset the status to 'Ready to Send'.")
+    e = max(errs, key=lambda x: x.ts)
+    if e.kind == "lookup_not_found":
+        hint = closest(e.value, lookups.get(e.field, ()))
+        fix = f"Correct {e.field} in the planner"
+        fix += f" (closest valid value: {hint})" if hint else ""
+        return (f"{e.field} '{e.value}' is not in the ERP master data.",
+                fix + ", then reset the status to 'Ready to Send'.")
+    return (f"Loader reported '{e.kind}'.", "Read the loader log for this job, fix the data, reset the status.")
+
+
+def find_issues(planner, erp, events, lookups, now: datetime, cfg):
+    grace = timedelta(minutes=cfg["grace_minutes"])
+    stuck = timedelta(minutes=cfg["stuck_minutes"])
+    cycle = cfg["scheduler_interval_minutes"]
+    issues = []
+    for job in planner:
+        changed = datetime.fromisoformat(job["status_changed_at"])
+        status = job["status"]
+        if status == "Sent to ERP":
+            if now - changed < grace:
+                continue  # the consumer is asynchronous; give it time
+            hrs = round((now - changed).total_seconds() / 3600, 1)
+            row = erp.get(job["job_id"])
+            if row is None:
+                cause, fix = _explain_reject(job, events, changed, lookups)
+                issues.append(Issue(job["job_id"], NOT_LOADED, job["status_changed_at"], hrs,
+                                    "Marked 'Sent to ERP' but not in the ERP jobs table.", cause, fix))
+                continue
+            diffs = [f"{f}: planner '{job[f]}' vs ERP '{row.get(f)}'"
+                     for f in cfg["compare_fields"] if not same(job.get(f), row.get(f))]
+            if diffs:
+                issues.append(Issue(job["job_id"], FIELD_MISMATCH, job["status_changed_at"], hrs,
+                                    "; ".join(diffs),
+                                    "Loaded without an error but the values differ. Likely a transform or mapping issue.",
+                                    "Compare the CSV column mapping for these fields, then correct the ERP row or re-send."))
+        elif status == "Ready to Send" and now - changed > stuck:
+            mins = (now - changed).total_seconds() / 60
+            issues.append(Issue(job["job_id"], STUCK_READY, job["status_changed_at"],
+                                round(mins / 60, 3),
+                                f"'Ready to Send' for {int(mins)} min; the scheduler has run about {int(mins // cycle)} times since.",
+                                "The scheduled job did not pick this record up.",
+                                "Check the scheduler run history and whether the record is locked or filtered out."))
+    return sorted(issues, key=lambda i: -i.age_hours)
